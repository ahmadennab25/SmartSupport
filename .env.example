# Django Config
SECRET_KEY='your-secret-key'
DEBUG=True
ALLOWED_HOSTS='localhost,127.0.0.1,.ngrok-free.dev,.ngrok-free.app,.ngrok.app'

# Main Database Config (PostgreSQL)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=<database user>
DATABASE_PASSWORD=<database password>
DATABASE_NAME=SmartSupport
DATABASE_SCHEMA=SmartSupport

# OpenAI Config
OPENAI_API_KEY='your-openai-api-key'
OPENAI_MODEL='gpt-4o-mini'
OPENAI_EMBEDDING_MODEL='text-embedding-3-small'
OPENAI_MAX_RETRIES=3
OPENAI_DEFAULT_TEMPERATURE=0.3
OPENAI_DEFAULT_ERROR_MESSAGE="I'm sorry, I'm having trouble connecting right now. Please try again in a moment."

# Twilio / WhatsApp Config
# From the Twilio console. TWILIO_WHATSAPP_FROM is your Twilio WhatsApp sender,
# e.g. the sandbox number "whatsapp:+14155238886" (it may change, always copy it from your console).
TWILIO_ACCOUNT_SID=''
TWILIO_AUTH_TOKEN=''
TWILIO_WHATSAPP_FROM='whatsapp:+14155238886'
# Verify the X-Twilio-Signature header on incoming webhooks. Keep True: otherwise anyone who can reach the
# webhook can pretend to be any customer. (It is always on when DEBUG=False; it needs TWILIO_AUTH_TOKEN.)
TWILIO_VALIDATE_REQUESTS=True

# Chat API (POST /api/chat/ requires this value in the X-API-Key header)
CHAT_API_KEY='your-chat-api-key'
# Optional: exact public webhook URL for Twilio signature validation (e.g. your ngrok URL)
TWILIO_WEBHOOK_URL=''

# RAG (phase 5)
RAG_TOP_K=4
RAG_MIN_SCORE=0.2
EMBEDDING_BATCH_SIZE=64

# Agent system prompt version: v1, v2 or v3 (default v3)
AGENT_PROMPT_VERSION=v3
